DISCORD_TOKEN=your_discord_bot_token_here
LOG_CHANNEL_ID=your_log_channel_id_here
WEB_PORT=30001
DEV_ID=your_developer_discord_id_here

# Discord OAuth2 設定
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_CLIENT_SECRET=your_client_secret_here
DISCORD_REDIRECT_URI=https://your-domain.com:30001/callback
SESSION_SECRET=your_random_secret_here

SSL_CERT=/path/to/fullchain.pem
SSL_KEY=/path/to/privkey.pem

# Lavalink 連線資訊
LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass
LAVALINK_SECURE=false

# 機器人狀態設定
BOT_STATUS_TYPE=playing
BOT_STATUS_TEXT=使用者總數丨{users}位
BOT_STATUS_REFRESH_SECONDS=300
BOT_STATUS_URL=https://twitch.tv/your_channel

# Gemini AI 聊天設定 (多金鑰以逗號分隔，作為視覺辨識與備援)
GEMINI_API_KEYS=your_gemini_key1,your_gemini_key2
GEMINI_MODEL=gemini-2.5-flash-lite

# AI 提供者設定：可設定為 openrouter (推薦) 或 deepseek
AI_PROVIDER=openrouter

# OpenRouter AI 設定 (預設採用 Google Gemini 3.7 Flash，備援 Claude / GPT-4o 頂級旗艦)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.5-flash
# 頂級候選清單（最多 3 個，依序備援）：
OPENROUTER_MODELS=google/gemini-2.5-flash,google/gemini-3.7-flash,anthropic/claude-sonnet-5
OPENROUTER_VISION_MODELS=google/gemini-2.5-flash,google/gemini-3.7-flash,anthropic/claude-sonnet-5

# DeepSeek AI 聊天設定 (高級旗艦：支援 deepseek-chat 與 deepseek-reasoner 深度推理)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_VISION_MODEL=deepseek-v4-flash-vision-exp
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
